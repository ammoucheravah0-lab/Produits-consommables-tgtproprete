# --- Commande par e-mail (app/api/commande) — https://resend.com ---
# Sans RESEND_API_KEY, le panier ouvre le client mail pré-rempli du visiteur (aucun message perdu).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
ORDER_TO_EMAIL=Contact@tgtproprete.fr            # boîte qui reçoit les commandes
ORDER_FROM_EMAIL="TGT Propreté <commandes@tgtproprete.fr>"   # domaine vérifié dans Resend

# --- Assistant IA (app/api/chat) ---
ANTHROPIC_API_KEY=sk-ant-...        # clé API Anthropic (jamais dans le code)
